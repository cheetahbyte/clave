# Used by Compose interpolation. Keep these URL-safe (hex is a good choice).
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
RABBITMQ_PASSWORD=replace-with-a-long-random-hex-value

# Absolute host path; Compose mounts it read-only into the backend.
LICENSE_JWT_PRIVATE_KEY_FILE=/opt/clave/secrets/license-jwt-private.pem
LICENSE_HMAC_SECRET=replace-with-a-long-random-value
SELF_SERVICE_TOKEN_PEPPER=replace-with-a-long-random-value
CSRF_AUTH_KEY=replace-with-64-hex-characters
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters

PUBLIC_APP_URL=https://clave.example.com
TRUST_PROXY_HEADERS=true
RUN_MIGRATIONS=true
PORT=8000
DATABASE_MAX_CONNS=20
UPDATE_CHECK_RETENTION_DAYS=90
# Shared high-entropy bearer token for the backend and delta worker.
WORKER_TOKEN=replace-with-a-long-random-value

# Transactional email worker. URL-encode credentials if they contain URL metacharacters.
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=Clave <no-reply@example.com>

# Optional observability.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=clave-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
