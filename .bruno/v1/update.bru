meta {
  name: update
  type: http
  seq: 5
}

post {
  url: {{host}}/api/{{version}}/updates/check
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer <activation-jwt>
}

body:json {
  {
    "version": "0.1",
    "platform": "macos",
    "channel": "stable",
    "arch": "arm64"
  }
}

vars:pre-request {
  host: http://localhost:8000
}

settings {
  encodeUrl: true
  timeout: 0
}
